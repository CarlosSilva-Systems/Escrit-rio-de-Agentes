# Escritorio da Equipe - environment variables (none of them is a secret).
# Tokens live in ~/.escritorio-equipe/ (ACL restricted), never here.

# Loopback port. If busy the server exits with an error; it never picks another port.
ESCRITORIO_PORT=3200

# Runtime data directory (tokens, state, cache, logs). Empty = %USERPROFILE%\.escritorio-equipe
ESCRITORIO_HOME=

# Root folder whose first-level subfolders are the projects.
ESCRITORIO_DEV_ROOT=C:\Users\<you>\Documents\7 - DEV

# trace | debug | info | warn | error
ESCRITORIO_LOG_LEVEL=info

# Absolute path to claude.exe (empty = resolved from PATH, .exe only).
CLAUDE_BIN=

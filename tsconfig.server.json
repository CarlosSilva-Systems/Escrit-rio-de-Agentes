{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/shared/**/*",
    "src/server/**/*",
    "src/cli/**/*",
    "tests/**/*",
    "scripts/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["src/web/**/*", "tests/e2e/**/*", "node_modules", "dist"]
}
